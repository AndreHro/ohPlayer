#pragma once

#include <OpenHome/Types.h>
#include <OpenHome/Private/Standard.h>
#include <OpenHome/Media/Pipeline/Msg.h>
#include <memory>
#include "IKfrDsp.h"

namespace OpenHome {
namespace Media {

class KfrDspFilter : public PipelineElement, public IPipelineElementUpstream, private INonCopyable
{
public:
    KfrDspFilter(IPipelineElementUpstream& aUpstreamElement, 
                 const char* aSharedLibName, 
                 const char* aFilterPathOrJson);
    ~KfrDspFilter() = default;

public: // from IPipelineElementUpstream
    Msg* Pull() override;

private: // from PipelineElement (IMsgProcessor)
    Msg* ProcessMsg(MsgMode* aMsg) override { return aMsg; }
    Msg* ProcessMsg(MsgDrain* aMsg) override { return aMsg; }
    Msg* ProcessMsg(MsgDelay* aMsg) override { return aMsg; }
    Msg* ProcessMsg(MsgDecodedStream* aMsg) override { return aMsg; }
    Msg* ProcessMsg(MsgAudioPcm* aMsg) override;
    Msg* ProcessMsg(MsgSilence* aMsg) override { return aMsg; }

private:
    struct DLCloser {
        void operator()(void* h) const { if (h) ::dlclose(h); }
    };
    struct KfrContextDeleter {
        void* libHandle = nullptr;
        void operator()(KfrDspContext* ctx) const {
            if (ctx && libHandle) {
                typedef void (*DestroyFunc)(KfrDspContext*);
                auto destroy = reinterpret_cast<DestroyFunc>(::dlsym(libHandle, "kfr_dsp_destroy"));
                if (destroy) destroy(ctx);
            }
        }
    };

    std::unique_ptr<KfrDspContext, KfrContextDeleter> iDspContext;
    std::unique_ptr<void, DLCloser> iLibHandle;
    IPipelineElementUpstream& iUpstreamElement;
    
    typedef int (*ProcessFuncPtr)(KfrDspContext*, void*, size_t, unsigned, KfrAudioType);
    ProcessFuncPtr iProcessFunc;
};

} // namespace Media
} // namespace OpenHome
