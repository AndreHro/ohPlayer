# ============================================================================
# Minimalist Makefile for ohPlayer
# ============================================================================

OSPLATFORM = raspbian
TARGET     = $(OSPLATFORM)/openhome-player
CXX        = clang++

# Architecture Target Definitions
TARG_ARCH  = aarch64-scarthgap-linux
BUILD_TYPE = Release
OBJ_DIR    = $(OSPLATFORM)/objs


KFR_DIR       ?= ../dependencies/$(TARG_ARCH)/kfr
CAPTURE_ALSA  ?= 1

BUILD_FLAGS = -std=c++20 -fstack-protector -fstack-check -DDEFINE_LITTLE_ENDIAN -fpermissive -DENABLE_KFR_DSP
ifeq ($(BUILD_TYPE), Release)
	BUILD_FLAGS += -O3 -march=native -ffast-math -fno-finite-math-only -DNDEBUG
else
	BUILD_FLAGS += -Og -g -gdwarf-4 -Wall -Wextra -DDEBUG
endif

# Core Compiler Optimization and Assembly Flags
CFLAGS = -c $(BUILD_FLAGS) -DTARG_ARCH=$(TARG_ARCH) \
         $(shell pkg-config --cflags glib-2.0)

# Native Installation Path Configurations
PREFIX      = /usr
DESTDIR     = $(PREFIX)
BINDIR      = /bin
RESDIR      = /share/openhome-player
DOCDIR      = /share/doc/openhome-player
RESOURCEDIR = ConfigUI/res
DEPRESOURCEDIR = ../dependencies/$(TARG_ARCH)/ohMediaPlayer/res

LIBS = $(shell pkg-config --libs glib-2.0) \
       -lConfigUiTestUtils -lConfigUi -lSourcePlaylist -lSourceSongcast \
       -lSourceUpnpAv -lPodcast -lSourceRadio -lSourceScd -lohMediaPlayer \
       -lWebAppFramework $(DEPS_DIR)/ohNet/lib/libohNetCore.a \
       -lCodecAifc \
       -lCodecAlacApple -lCodecAlacAppleBase -lCodecPcm -lCodecAiff \
       -lCodecAiffBase -lCodecVorbis -llibOgg -lCodecFlac -lCodecWav \
       -lCodecDsdDsf -lCodecDsdDff -lCodecDsdRaw -lSourceRaop -lohPipeline \
       -lCodecAacFdkAdts -lCodecAacFdkBase -lCodecMp3 -lCodecAacFdkMp4 -lCodecAacFdk \
       -lkfr_dft -lkfr_dsp \
       -lpthread -lasound -ldl -lm -lOdp -lssl -lcrypto

# Static Search Path Directories
DEPS_DIR = ../dependencies/$(TARG_ARCH)
INCLUDES = -I. -Iradio -Isorx \
           -I$(DEPS_DIR)/ohMediaPlayer/include \
           -I$(DEPS_DIR)/ohNetmon/include \
           -I$(DEPS_DIR)/ohNetGenerated \
           -I$(DEPS_DIR)/ohNet/include/ohnet \
           -I$(DEPS_DIR) \
           -I$(KFR_DIR)/include

LDFLAGS  = -L$(DEPS_DIR)/ohMediaPlayer/lib \
           -L$(DEPS_DIR)/ohNetmon/lib \
           -L$(DEPS_DIR)/ohNet/lib \
           -L$(DEPS_DIR)/ohNetGenerated/lib \
           -L$(KFR_DIR)/lib

# Workspace Source Track Aggregations
SOURCES  = $(filter-out SoxrProcessor.cpp KfrDspProcessor.cpp KfrDspFilter.cpp KfrDspFilterImpl.cpp, $(wildcard *.cpp))
SOURCES += sorx/ConvertBELE.cpp
ifeq ($(CAPTURE_ALSA),1)
BUILD_FLAGS += -DCAPTURE_ALSA=1
SOURCES += $(wildcard capture/*.cpp)
endif
SOURCES += $(wildcard LinnAmp/*.cpp)
SOURCES += $(wildcard ConfigUI/*.cpp)
SOURCES += $(wildcard radio/*.cpp)
OHNG_PROVIDER_DIR = $(DEPS_DIR)/Generated
SOURCES += $(OHNG_PROVIDER_DIR)/DvUpnpOrgContentDirectory1.cpp
SOURCES += $(OHNG_PROVIDER_DIR)/DvUpnpOrgConnectionManager1.cpp
OBJECTS  = $(patsubst %.cpp, $(OBJ_DIR)/%.o, $(SOURCES))
HEADERS  = $(wildcard *.h capture/*.h)

# ============================================================================
# Compilation Build Automation Targets
# ============================================================================

.PHONY: default all clean build install uninstall deb

default: version build $(TARGET)
all: default

# Only ConfigAppPlayerLinn.cpp includes VersionInfo.h; depend it on
# VersionInfo.h. Kept after the default target so it does not become
# make's default goal. VERSION_FILE must be defined before the rule:
# prerequisites are expanded when the rule is read.
VERSION_FILE = VersionInfo.h
VERSION_OBJ = $(OBJ_DIR)/ConfigAppPlayerLinn.o
$(VERSION_OBJ): $(VERSION_FILE)

# Generate VersionInfo.h with dependency versions and git commit
OHNET_VERSION = $(shell grep -oP 'DEPS\[ohNet\]="\K[0-9.]+' ../fetch_deps.sh)
OHPIPELINE_VERSION = $(shell grep -oP 'DEPS\[ohMediaPlayer\]="\K[0-9.]+' ../fetch_deps.sh)
GIT_COMMIT = $(shell git -C .. rev-parse --short HEAD 2>/dev/null || echo unknown)

# Generate VersionInfo.h only when its content would change, so its
# timestamp (and thus dependent rebuilds) is untouched for ordinary builds.
version:
	@printf '// Generated by make - do not edit\n#pragma once\n\nnamespace VersionInfo {\nstatic const char* const kOhNet = "%s";\nstatic const char* const kOhPipeline = "%s";\nstatic const char* const kOhPlayerCommit = "%s";\n}\n' \
		'$(OHNET_VERSION)' '$(OHPIPELINE_VERSION)' '$(GIT_COMMIT)' > $(VERSION_FILE).tmp
	@if [ ! -f $(VERSION_FILE) ] || ! cmp -s $(VERSION_FILE).tmp $(VERSION_FILE); then \
		 mv $(VERSION_FILE).tmp $(VERSION_FILE); \
		 echo 'Generated $(VERSION_FILE): ohNet=$(OHNET_VERSION) ohPipeline=$(OHPIPELINE_VERSION) commit=$(GIT_COMMIT)'; \
	else \
		 rm -f $(VERSION_FILE).tmp; \
	fi

.PHONY: version

# vpath lets the implicit rule find sources in subdirectories.
vpath %.cpp radio
vpath %.cpp LinnAmp
vpath %.cpp ConfigUI
vpath %.cpp $(OHNG_PROVIDER_DIR)

$(OBJ_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CFLAGS) $(INCLUDES) -I$(OHNG_PROVIDER_DIR) -c $< -o $@

# Per-object header dependencies generated by -MMD -MP.
-include $(OBJECTS:.o=.d)

.PRECIOUS: $(TARGET) $(OBJECTS)

$(TARGET): $(OBJECTS)
	$(CXX) -Wall $(LDFLAGS) -Wl,--start-group $(OBJECTS) $(LIBS) -Wl,--end-group -o $@

build: ; @mkdir -p $(OBJ_DIR)/capture

clean:
	rm -rf $(OSPLATFORM)/objs
	rm -f $(TARGET)

install:
	install -m 755 -d $(DESTDIR)$(BINDIR) $(DESTDIR)$(DOCDIR) $(DESTDIR)$(RESDIR)
	install -m 755 $(TARGET) $(DESTDIR)$(BINDIR)
	install -m 644 OpenHome-48x48.png $(DESTDIR)$(RESDIR)
	install -m 644 copyright $(DESTDIR)$(DOCDIR)
	install -m 755 -d $(DESTDIR)$(RESDIR)/res
	cp -a $(RESOURCEDIR)/. $(DESTDIR)$(RESDIR)/res/
	install -m 644 $(DEPRESOURCEDIR)/webconfig.js $(DESTDIR)$(RESDIR)/res

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/openhome-player
	rm -rf $(DESTDIR)$(DOCDIR)
	rm -rf $(DESTDIR)$(RESDIR)

# Build an apt (.deb) package: builds the renderer, stages it and packs it
# with dpkg-deb. Options are forwarded to the script, e.g.:
#   make deb DEB_ARGS="--version 1.0.7 --output dist"
deb:
	./make-apt-package.sh $(DEB_ARGS)
